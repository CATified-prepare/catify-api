# Copy to ".env" for local overrides (this repo ignores ".env")

# PostgreSQL
POSTGRES_USER=catify
POSTGRES_PASSWORD=catify
POSTGRES_DB=catify
POSTGRES_PORT=5432
POSTGRES_TAG=16-alpine

# Redis
REDIS_PORT=6379
REDIS_TAG=7-alpine

# Qdrant
QDRANT_PORT=6333
QDRANT_TAG=latest

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_TAG=latest
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin

# gemini
GEMINI_API_KEY=geminiApiKey

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_PULL_MODEL_STRATEGY=never
OLLAMA_TEMPERATURE=0.3
OLLAMA_HTTP_CONNECT_TIMEOUT=5s
OLLAMA_HTTP_READ_TIMEOUT=120s
