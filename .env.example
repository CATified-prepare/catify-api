# Copy to ".env" for local overrides (this repo ignores ".env")

# PostgreSQL
POSTGRES_USER=catify
POSTGRES_PASSWORD=catify
POSTGRES_DB=catify
POSTGRES_PORT=5432
POSTGRES_TAG=16-alpine

# Redis
REDIS_PORT=6379
REDIS_TAG=7-alpine

# Qdrant
QDRANT_PORT=6333
QDRANT_TAG=latest

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_TAG=latest
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin
